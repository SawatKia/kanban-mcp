{
  "name": "mcp-kanban",
  "version": "0.0.6",
  "description": "MCP server for kanban board",
  "license": "MIT",
  "author": "Brad Risse",
  "type": "module",
  "bin": {
    "mcp-server-kanban": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && shx chmod +x dist/*.js",
    "watch": "tsc --watch",
    "up": "docker compose --env-file .env up -d --build",
    "up:prebuilt": "docker compose -f docker-compose.prebuilt.yml --env-file .env up -d",
    "down": "docker compose down",
    "down:prebuilt": "docker compose -f docker-compose.prebuilt.yml down",
    "restart": "docker compose --env-file .env restart",
    "build:ui": "docker compose build kanban",
    "build-docker": "npm run build && docker build -t mcp-kanban:latest .",
    "db:backup": "node scripts/backup.js",
    "db:schedule-backup": "powershell -ExecutionPolicy Bypass -File ./scripts/schedule-backup.ps1",
    "start": "node dist/index.js",
    "start-node": "node dist/index.js",
    "inspector": "SERVER_PORT=3008 CLIENT_PORT=5174 npx -y @modelcontextprotocol/inspector node dist/index.js",
    "inspector:demo": "SERVER_PORT=3008 CLIENT_PORT=5174 npx -y @modelcontextprotocol/inspector node dist/index.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --testMatch='**/tests/**/*.test.ts' --testPathIgnorePatterns='integration\\.test\\.ts$'",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js --testMatch='**/tests/integration.test.ts'"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/node": "^22",
    "@types/node-fetch": "^2.6.12",
    "node-fetch": "^3.3.2",
    "universal-user-agent": "^7.0.2",
    "zod": "^3.22.4",
    "zod-to-json-schema": "^3.23.5"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "shx": "^0.3.4",
    "ts-jest": "^29.2.6",
    "typescript": "^5.6.2"
  }
}
